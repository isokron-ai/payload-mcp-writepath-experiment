diff --git a/packages/plugin-mcp/src/mcp/helpers/rowIds.ts b/packages/plugin-mcp/src/mcp/helpers/rowIds.ts
new file mode 100644
index 0000000..42d4a32
--- /dev/null
+++ b/packages/plugin-mcp/src/mcp/helpers/rowIds.ts
@@ -0,0 +1,94 @@
+/**
+ * C-row-ids (research v2.2): stable array row ids when the same rows are sent again. Payload gives every array or
+ * blocks row sent without an id a new id, so an update that re-sends the rows it read, without their ids, replaced
+ * them all: the row ids changed on every call (the update tools declare idempotentHint: true) and the rows' values in
+ * other locales were lost. A row sent without an id that is identical to the stored row at the same position (every
+ * value it sends equal, every value it leaves out empty in the stored row) now keeps that row's id, as if the caller
+ * had sent it. A row that differs in any value, or that moved, is still a new row. An id is never given to two rows.
+ */
+type Plain = Record<string, unknown>
+
+const isPlain = (v: unknown): v is Plain => v !== null && typeof v === 'object' && !Array.isArray(v)
+const isEmpty = (v: unknown) => v === null || v === undefined
+
+/** The data to write, with the ids of unchanged rows filled in from the stored document. */
+export function keepRowIds(data: Plain, stored: null | Plain | undefined): Plain {
+  return isPlain(stored) ? (keepFields(data, stored) as Plain) : data
+}
+
+/** True when any value in the data is an array (only then can rows lose their ids). */
+export const hasArrays = (data: Plain): boolean =>
+  Object.values(data).some((v) => Array.isArray(v) || (isPlain(v) && hasArrays(v)))
+
+function keepFields(sent: Plain, stored: Plain): Plain {
+  const out: Plain = {}
+  for (const [k, v] of Object.entries(sent)) {
+    out[k] = keep(v, stored[k])
+  }
+  return out
+}
+
+function keep(sent: unknown, stored: unknown): unknown {
+  if (Array.isArray(sent) && Array.isArray(stored)) {
+    const taken = new Set(sent.filter((r) => isPlain(r) && !isEmpty(r.id)).map((r) => String((r as Plain).id)))
+    return sent.map((row, i) => {
+      if (!isPlain(row)) {
+        return row
+      }
+      if (!isEmpty(row.id)) {
+        const same = stored.find((r) => isPlain(r) && String(r.id) === String(row.id))
+        return isPlain(same) ? keepFields(row, same) : row
+      }
+      const at = stored[i]
+      if (isPlain(at) && !isEmpty(at.id) && !taken.has(String(at.id)) && sameContent(row, at)) {
+        taken.add(String(at.id))
+        return adopt(row, at)
+      }
+      return row
+    })
+  }
+  if (isPlain(sent) && isPlain(stored)) {
+    return keepFields(sent, stored)
+  }
+  return sent
+}
+
+/** Equal values, ignoring the ids the sent side leaves out; a value the sent side leaves out must be empty. */
+function sameContent(sent: unknown, stored: unknown): boolean {
+  if (Array.isArray(sent)) {
+    return Array.isArray(stored) && sent.length === stored.length && sent.every((v, i) => sameContent(v, stored[i]))
+  }
+  if (isPlain(sent)) {
+    if (!isPlain(stored)) {
+      return false
+    }
+    for (const [k, v] of Object.entries(sent)) {
+      if (k === 'id' && isEmpty(v)) {
+        continue
+      }
+      if (!sameContent(v, stored[k])) {
+        return false
+      }
+    }
+    return Object.entries(stored).every(([k, v]) => k === 'id' || k in sent || isEmpty(v))
+  }
+  return sent === stored || (isEmpty(sent) && isEmpty(stored))
+}
+
+/** The sent row with the stored ids filled in where it left them out (the content is the same, so is the shape). */
+function adopt(sent: unknown, stored: unknown): unknown {
+  if (Array.isArray(sent) && Array.isArray(stored)) {
+    return sent.map((v, i) => adopt(v, stored[i]))
+  }
+  if (isPlain(sent) && isPlain(stored)) {
+    const out: Plain = {}
+    for (const [k, v] of Object.entries(sent)) {
+      out[k] = adopt(v, stored[k])
+    }
+    if (isEmpty(sent.id) && !isEmpty(stored.id)) {
+      out.id = stored.id
+    }
+    return out
+  }
+  return sent
+}
diff --git a/packages/plugin-mcp/src/mcp/tools/resource/rowIds.spec.ts b/packages/plugin-mcp/src/mcp/tools/resource/rowIds.spec.ts
new file mode 100644
index 0000000..456c880
--- /dev/null
+++ b/packages/plugin-mcp/src/mcp/tools/resource/rowIds.spec.ts
@@ -0,0 +1,124 @@
+// updatePosts declares idempotentHint: true. Research v2.1 gave every array row sent without an id a new id on every
+// call, so repeating the same update changed the document again (new row ids, and with them the rows' values in other
+// locales). A row sent without an id that is identical to the stored row at the same position now keeps that row's id.
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('payload/shared', () => ({ fieldIsVirtual: () => false }))
+
+import { keepRowIds } from '../../helpers/rowIds.js'
+import { connect, createStore, jsonIn, type Store } from './fakePayload.spec-utils.js'
+
+let store: Store
+beforeEach(() => {
+  store = createStore()
+})
+
+type Row = { id: string; label: string; url?: null | string }
+const rows = (id: number) => store.read('posts', id).items as Row[]
+const seed = async (items: Array<Omit<Row, 'id'>>) =>
+  (await store.payload.create({ collection: 'posts', data: { title: 'p', author: 'ann', items } })) as {
+    id: number
+    updatedAt: string
+  }
+
+describe('array row ids are stable when the same rows are sent again (MWS-ANN-3)', () => {
+  it('repeating an update of an array with the same rows keeps the row ids', async () => {
+    const post = await seed([{ label: 'one', url: 'https://example.test/1' }])
+    const a = await connect(store)
+    const items = [{ label: 'one', url: 'https://example.test/x' }]
+    const r1 = await a.call('updatePosts', { id: post.id, ifUpdatedAt: post.updatedAt, items })
+    expect(r1.isError).toBe(false)
+    const after1 = rows(post.id)
+    const r2 = await a.call('updatePosts', { id: post.id, ifUpdatedAt: jsonIn(r1.text).updatedAt, items })
+    expect(r2.isError).toBe(false)
+    expect(rows(post.id)).toEqual(after1)
+  })
+
+  it('a row whose values changed is a new row; an unchanged row at the same position keeps its id', async () => {
+    const post = await seed([
+      { label: 'one', url: 'https://example.test/1' },
+      { label: 'two', url: 'https://example.test/2' },
+    ])
+    const before = rows(post.id)
+    const a = await connect(store)
+    const r = await a.call('updatePosts', {
+      id: post.id,
+      ifUpdatedAt: post.updatedAt,
+      items: [
+        { label: 'one', url: 'https://example.test/1' },
+        { label: 'two', url: 'https://example.test/changed' },
+      ],
+    })
+    expect(r.isError).toBe(false)
+    const after = rows(post.id)
+    expect(after[0]!.id).toBe(before[0]!.id)
+    expect(after[1]!.id).not.toBe(before[1]!.id)
+    expect(after[1]!.url).toBe('https://example.test/changed')
+  })
+
+  it('a row moved to another position does not take the id of the row stored there', async () => {
+    const post = await seed([{ label: 'one' }, { label: 'two' }])
+    const before = rows(post.id)
+    const a = await connect(store)
+    await a.call('updatePosts', { id: post.id, ifUpdatedAt: post.updatedAt, items: [{ label: 'two' }, { label: 'one' }] })
+    const after = rows(post.id)
+    expect(after.map((r) => r.label)).toEqual(['two', 'one'])
+    expect(after.map((r) => r.id)).not.toContain(before[0]!.id)
+    expect(after.map((r) => r.id)).not.toContain(before[1]!.id)
+  })
+
+  it('rows sent with their ids are written as sent, and an id is never given to two rows', async () => {
+    const post = await seed([{ label: 'one' }, { label: 'two' }])
+    const before = rows(post.id)
+    const a = await connect(store)
+    await a.call('updatePosts', {
+      id: post.id,
+      ifUpdatedAt: post.updatedAt,
+      items: [{ id: before[1]!.id, label: 'two' }, { label: 'two' }],
+    })
+    const after = rows(post.id)
+    expect(after[0]!.id).toBe(before[1]!.id)
+    expect(after[1]!.id).not.toBe(before[1]!.id)
+  })
+
+  it('the same call sent twice (the same ifUpdatedAt) is refused the second time and changes nothing', async () => {
+    const post = await seed([{ label: 'one' }])
+    const a = await connect(store)
+    const args = { id: post.id, ifUpdatedAt: post.updatedAt, items: [{ label: 'uno' }] }
+    expect((await a.call('updatePosts', args)).isError).toBe(false)
+    const once = store.read('posts', post.id)
+    const again = await a.call('updatePosts', args)
+    expect(again.isError).toBe(true)
+    expect(store.read('posts', post.id)).toEqual(once)
+  })
+
+  it('updatePosts still declares idempotentHint: true', async () => {
+    const a = await connect(store)
+    const t = (await a.tools()).find((x) => x.name === 'updatePosts')!
+    expect(t.annotations?.idempotentHint).toBe(true)
+  })
+
+  it('keepRowIds: blocks and nested arrays; a stored value the row leaves out must be empty', () => {
+    const stored = {
+      layout: [
+        { id: 'b1', blockName: null, blockType: 'hero', heading: 'Hi' },
+        { id: 'b2', blockType: 'cta', label: 'Go', links: [{ id: 'l1', href: '/a' }] },
+        { id: 'b3', blockType: 'quote', text: 'q', attribution: 'someone' },
+      ],
+    }
+    const out = keepRowIds(
+      {
+        layout: [
+          { blockType: 'hero', heading: 'Hi' },
+          { blockType: 'cta', label: 'Go', links: [{ href: '/a' }] },
+          { blockType: 'quote', text: 'q' },
+        ],
+      },
+      stored,
+    ) as { layout: Array<Record<string, unknown>> }
+    expect(out.layout[0]!.id).toBe('b1')
+    expect(out.layout[1]!.id).toBe('b2')
+    expect((out.layout[1]!.links as Array<{ id: string }>)[0]!.id).toBe('l1')
+    expect(out.layout[2]!.id).toBeUndefined()
+  })
+})
